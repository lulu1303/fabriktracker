{
  "buildCommand": "sed -i \"s/?v=[A-Za-z0-9]*/?v=$(echo ${VERCEL_GIT_COMMIT_SHA:-dev} | cut -c1-8)/g\" index.html",
  "outputDirectory": ".",
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    }
  ]
}
